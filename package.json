{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cv:gen": "python3 cv/generate.py",
    "cv": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless --disable-gpu --no-pdf-header-footer --allow-file-access-from-files --print-to-pdf=public/cv.pdf \"file://$PWD/cv/curriculo.html\"",
    "cv:en": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless --disable-gpu --no-pdf-header-footer --allow-file-access-from-files --print-to-pdf=public/cv-en.pdf \"file://$PWD/cv/curriculo-en.html\""
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  }
}
